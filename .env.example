# Vertex AI / Gemini configuration consumed by services/ai/aiClient.js.
# Auth uses Application Default Credentials (gcloud auth application-default login
# in dev; service-account-attached runtime in prod) — no key file goes here.
GCP_PROJECT_ID=my-fit-her
GCP_LOCATION=us-central1

# ─── CRM → app backend calls (Nov 2026) ─────────────────────
# Optional separate key for calls FROM the CRM. Same value in the CRM's .env.
# Unset = APP_WEBHOOK_SECRET.
CRM_TO_APP_SECRET=
# Once the CRM signs its pushes (deployed), set to false to stop accepting the
# old raw x-internal-secret header on /internal/app-notify and support-ticket-update.
ALLOW_LEGACY_INTERNAL_SECRET=true
