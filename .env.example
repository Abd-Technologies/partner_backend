# Vertex AI / Gemini configuration consumed by services/ai/aiClient.js.
# Auth uses Application Default Credentials (gcloud auth application-default login
# in dev; service-account-attached runtime in prod) — no key file goes here.
GCP_PROJECT_ID=my-fit-her
GCP_LOCATION=us-central1

# ─── CRM → app backend calls (Nov 2026) ─────────────────────
# Optional separate key for calls FROM the CRM. Same value in the CRM's .env.
# Unset = APP_WEBHOOK_SECRET.
CRM_TO_APP_SECRET=
# Once the CRM signs its pushes (deployed), set to false to stop accepting the
# old raw x-internal-secret header on /internal/app-notify and support-ticket-update.
ALLOW_LEGACY_INTERNAL_SECRET=true

# ─── Processes, monitoring, security (Nov 2026) ──────────────
# Which scheduled jobs this process runs: all (default) | web (only the jobs
# that push live socket updates) | worker | none. ecosystem.config.js runs
# app.js with web and worker.js with worker.
RUN_JOBS=all
# Slack / Google Chat / Discord incoming webhook for new errors / spikes.
ALERT_WEBHOOK_URL=
ALERT_ERROR_SPIKE=50
# Browsers may call this API only from these sites (comma-separated).
# Unset = any site. The mobile app is not affected.
CORS_ORIGINS=https://thefither.com,https://analytics.thefither.com
# Old no-expiry login tokens stop working after this date (GET /admin/legacy-tokens).
LEGACY_TOKEN_UNTIL=2026-12-31
